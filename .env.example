# Non-secret defaults for I3. Copy to .env and fill locally.
PEGA_NAMESPACE=mayabank-pega
PEGA_RELEASE=mayabank-pega
PEGA_VERSION=26.1.1

# Official Helm chart. Leave version empty to use the currently selected repo version after review.
PEGA_HELM_CHART=pega/pega
PEGA_HELM_CHART_VERSION=

# Authorized Pega images: REQUIRED at runtime, never guess values.
PEGA_WEB_IMAGE=
PEGA_INSTALLER_IMAGE=
PEGA_CLUSTERING_SERVICE_IMAGE=

# OpenShift route. If empty, scripts derive pega.<apps-domain> from the cluster.
PEGA_ROUTE_HOST=

# Database metadata. Exact PostgreSQL major/JDBC compatibility must be checked
# for the selected Pega patch before the initial schema installation.
PEGA_JDBC_URL=jdbc:postgresql://pega-postgres:5432/pega
PEGA_JDBC_DRIVER_CLASS=org.postgresql.Driver
PEGA_DB_TYPE=postgres
PEGA_JDBC_DRIVER_URI=
PEGA_RULES_SCHEMA=pegarules
PEGA_DATA_SCHEMA=pegadata
POSTGRES_DB=pega
DB_USER=
DB_PASSWORD=
PEGA_ADMIN_PASSWORD=

# Optional registry secret name created locally.
PEGA_IMAGE_PULL_SECRET=pega-registry
PEGA_REGISTRY=
PEGA_REGISTRY_USER=
PEGA_REGISTRY_PASSWORD=

# CRC-only resource profile. It is a lab starting point, NOT production sizing.
PEGA_WEB_MEMORY=6Gi
PEGA_WEB_CPU_REQUEST=500m
PEGA_WEB_CPU_LIMIT=2
PEGA_WEB_HEAP=4096m
PEGA_CLUSTERING_REPLICAS=1

# First baseline disables stream integration; I6 introduces externalized Kafka.
PEGA_STREAM_ENABLED=false
PEGA_KAFKA_BOOTSTRAP=
PEGA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Optional local PostgreSQL. Keep false until the selected Pega patch support
# matrix has been checked and an OpenShift-compatible PostgreSQL image selected.
DEPLOY_LOCAL_POSTGRES=false
POSTGRES_IMAGE=
POSTGRES_STORAGE=10Gi

# Guardrails / explicit confirmations. These default to safe refusal.
APPLY_NETWORK_POLICIES=false
CONFIRM_NETWORK_POLICY_APPLY=no
CONFIRM_INITIAL_PEGA_INSTALL=no
CONFIRM_PEGA_LOGIN=no
CONFIRM_UNINSTALL=no
CONFIRM_DELETE_DATA=no
